  "services": {
    "refresh": {
      "name": "Refresh reports",
      "description": "Fetch all selected reports now, regardless of their interval.",
      "fields": {
        "config_entry_id": {
          "name": "Gateway",
          "description": "Only needed with several gateways."
        }
      }
    },
    "get_report": {
      "name": "Get report",
      "description": "Returns the last decoded report of a type (for scripts).",
      "fields": {
        "config_entry_id": {
          "name": "Gateway",
          "description": "Only needed with several gateways."
        },
        "report_type": {
          "name": "Report type",
          "description": "hourly, daily, weekly or monthly"
        }
      }
    },
    "show_command": {
      "name": "Run show command",
      "description": "Runs a read-only clish command (must start with 'show') and returns its output.",
      "fields": {
        "config_entry_id": {
          "name": "Gateway",
          "description": "Only needed with several gateways."
        },
        "command": {
          "name": "Command",
          "description": "e.g. show diag"
        }
      }
    },
    "syslog_messages": {
      "name": "Syslog messages",
      "description": "Returns the last received syslog messages (newest first).",
      "fields": {
        "config_entry_id": {
          "name": "Gateway",
          "description": "Only needed with several gateways."
        },
        "limit": {
          "name": "Limit",
          "description": "Number of messages (1–200)"
        },
        "product": {
          "name": "Product",
          "description": "Only messages of this product (ProductName), e.g. Anti-Virus, IPS, Firewall"
        }
      }
    },
    "detections": {
      "name": "Detections",
      "description": "Returns stored IPS and malware detections (newest first).",
      "fields": {
        "config_entry_id": {
          "name": "Gateway",
          "description": "Only needed with several gateways."
        },
        "days": {
          "name": "Days",
          "description": "Period (1–365)"
        },
        "kind": {
          "name": "Kind",
          "description": "ips_attack or malware_detected"
        }
      }
    },
    "telemetry_metrics": {
      "name": "Telemetry metrics",
      "description": "Returns the received OpenTelemetry metrics (newest value per series).",
      "fields": {
        "config_entry_id": {
          "name": "Gateway",
          "description": "Only needed with several gateways."
        },
        "prefix": {
          "name": "Prefix",
          "description": "Only series starting with this text"
        },
        "limit": {
          "name": "Limit",
          "description": "Max. rows"
        }
      }
    }
  },
  "exceptions": {
    "entry_not_found": {
      "message": "No (unique) loaded Quantum Spark entry found – pass config_entry_id."
    },
    "report_not_loaded": {
      "message": "Report {report_type} is not loaded (not selected in the options?)."
    },
    "only_show": {
      "message": "Only clish commands starting with 'show' are allowed."
    },
    "syslog_disabled": {
      "message": "Syslog reception is not enabled in the options."
    },
    "telemetry_disabled": {
      "message": "OpenTelemetry reception is not enabled in the options."
    }
  }
}
