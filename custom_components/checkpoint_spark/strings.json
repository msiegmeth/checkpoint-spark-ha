{
  "config": {
    "step": {
      "user": {
        "title": "Connect to Quantum Spark gateway",
        "description": "Local REST API of the gateway (enable on the gateway with `set rest-api mode on`). A read-only admin is sufficient.",
        "data": {
          "host": "Host / IP",
          "port": "Port",
          "username": "Username",
          "password": "Password",
          "verify_ssl": "Verify SSL certificate"
        }
      },
      "reauth_confirm": {
        "title": "Re-authenticate",
        "description": "Login to {host} failed. Enter the credentials again.",
        "data": {
          "username": "Username",
          "password": "Password"
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot connect to the gateway",
      "invalid_auth": "Invalid username or password",
      "unknown": "Unexpected error"
    },
    "abort": {
      "already_configured": "This gateway is already configured",
      "reauth_successful": "Re-authentication successful"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Options",
        "data": {
          "report_types": "Report types",
          "scan_interval_hourly": "Polling interval hourly report",
          "scan_interval_daily": "Polling interval daily report",
          "scan_interval_weekly": "Polling interval weekly report",
          "scan_interval_monthly": "Polling interval monthly report",
          "monitored_blades": "Monitored blades",
          "redact_diagnostics": "Redact network data in diagnostics",
          "syslog_enabled": "Receive syslog (preview)",
          "syslog_port": "Syslog UDP port",
          "syslog_ignore_sources": "Ignore sources (syslog)",
          "syslog_senders": "Additional senders (syslog relay)",
          "syslog_forward": "Forward syslog to",
          "syslog_retention_days": "Keep detections",
          "telemetry_enabled": "Receive OpenTelemetry (preview)",
          "telemetry_username": "OpenTelemetry user",
          "telemetry_password": "OpenTelemetry password"
        },
        "description": "Each report type is fetched at its own interval. Generating reports costs CPU on the gateway – keep long periods (weekly, monthly) at hours.",
        "data_description": {
          "monitored_blades": "The 'Blade failure' sensor turns on when one of these blades is not enabled.",
          "redact_diagnostics": "Replaces IP and MAC addresses and removes gateway name and host, so diagnostics can be shared in a public issue.",
          "syslog_enabled": "Listens for the gateway's log messages (only from its IP) and keeps the last 200 in memory – for analysing the log format. Configure the gateway to send syslog to this Home Assistant host.",
          "syslog_ignore_sources": "Comma-separated IPs whose IPS/malware detections do not raise events, e.g. your own vulnerability scanner.",
          "syslog_senders": "Comma-separated IPs/host names of log servers that forward the gateway's syslog (e.g. Synology Log Center, rsyslog). Leave empty if the gateway sends directly.",
          "syslog_forward": "Optional host:port (UDP) that receives every accepted message unchanged, e.g. an archive on your NAS.",
          "syslog_retention_days": "How long IPS and malware detections are kept (survive restarts). Raw messages are never stored.",
          "telemetry_enabled": "Accepts the gateway's Skyline/OpenTelemetry export (Prometheus remote write) at /api/checkpoint_spark/telemetry – only from the gateway IP, with the user/password below (basic auth). Enter the URL, user and password on the gateway under Logs & Monitoring → OpenTelemetry.",
          "telemetry_password": "At least 12 characters."
        }
      }
    },
    "error": {
      "no_report_type": "Select at least one report type",
      "invalid_forward": "Use host:port, e.g. 192.168.1.2:514",
      "telemetry_password": "Password of at least 12 characters required"
    }
  },
