  "services": {
    "refresh": {
      "name": "Reports abrufen",
      "description": "Alle gewählten Reports sofort abrufen, unabhängig vom Intervall.",
      "fields": {
        "config_entry_id": {
          "name": "Gateway",
          "description": "Nur bei mehreren Gateways nötig."
        }
      }
    },
    "get_report": {
      "name": "Report ausgeben",
      "description": "Gibt den zuletzt abgerufenen, dekodierten Report eines Typs zurück (für Scripts).",
      "fields": {
        "config_entry_id": {
          "name": "Gateway",
          "description": "Nur bei mehreren Gateways nötig."
        },
        "report_type": {
          "name": "Report-Typ",
          "description": "stündlich, täglich, wöchentlich oder monatlich"
        }
      }
    },
    "show_command": {
      "name": "Show-Befehl ausführen",
      "description": "Führt einen lesenden Clish-Befehl aus (muss mit „show“ beginnen) und gibt die Ausgabe zurück.",
      "fields": {
        "config_entry_id": {
          "name": "Gateway",
          "description": "Nur bei mehreren Gateways nötig."
        },
        "command": {
          "name": "Befehl",
          "description": "z. B. show diag"
        }
      }
    },
    "syslog_messages": {
      "name": "Syslog-Meldungen",
      "description": "Gibt die zuletzt empfangenen Syslog-Meldungen zurück (neueste zuerst).",
      "fields": {
        "config_entry_id": {
          "name": "Gateway",
          "description": "Nur bei mehreren Gateways nötig."
        },
        "limit": {
          "name": "Limit",
          "description": "Anzahl Meldungen (1–200)"
        },
        "product": {
          "name": "Produkt",
          "description": "Nur Meldungen dieses Produkts (ProductName), z. B. Anti-Virus, IPS, Firewall"
        }
      }
    },
    "detections": {
      "name": "Treffer",
      "description": "Gibt gespeicherte IPS- und Malware-Treffer zurück (neueste zuerst).",
      "fields": {
        "config_entry_id": {
          "name": "Gateway",
          "description": "Nur bei mehreren Gateways nötig."
        },
        "days": {
          "name": "Tage",
          "description": "Zeitraum (1–365)"
        },
        "kind": {
          "name": "Art",
          "description": "ips_attack oder malware_detected"
        }
      }
    },
    "telemetry_metrics": {
      "name": "Telemetrie-Metriken",
      "description": "Gibt die empfangenen OpenTelemetry-Metriken zurück (neuester Wert je Zeitreihe).",
      "fields": {
        "config_entry_id": {
          "name": "Gateway",
          "description": "Nur bei mehreren Gateways nötig."
        },
        "prefix": {
          "name": "Prefix",
          "description": "Nur Zeitreihen, die so beginnen"
        },
        "limit": {
          "name": "Limit",
          "description": "Max. Zeilen"
        }
      }
    }
  },
  "exceptions": {
    "entry_not_found": {
